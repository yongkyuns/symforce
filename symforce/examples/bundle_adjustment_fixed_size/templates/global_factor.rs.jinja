use stack_algebra::Matrix;
use symforce_rust::{FixedSizeLinearization, GlobalFactor};

use crate::between_factor::sym::between_factor_pose3_factor;
use crate::dataset;
use crate::inverse_range_prior_factor::sym::inverse_range_landmark_prior_factor;
use crate::reprojection_factor::sym::inverse_range_landmark_linear_gnc_factor;
use crate::BundleState;

const POSE_DIM: usize = {{ pose_dim }};
const STATE_DIM: usize = {{ state_dim }};
const RESIDUAL_DIM: usize = {{ residual_dim }};

/// Generated global fixed-size bundle-adjustment factor.
pub struct GlobalBundleFactor;

impl GlobalFactor<BundleState, f64, RESIDUAL_DIM, STATE_DIM> for GlobalBundleFactor {
    fn linearize_global(
        &self,
        state: &BundleState,
        linearization: &mut FixedSizeLinearization<RESIDUAL_DIM, STATE_DIM, f64>,
    ) {
        // Residual order follows FixedBundleAdjustmentProblem::_build_residual and the C++ path.
        for source_index in 0..dataset::NUM_VIEWS {
            for target_index in 0..dataset::NUM_VIEWS {
                if source_index == target_index {
                    continue;
                }
                let source = if source_index == 0 {
                    dataset::pose(0)
                } else {
                    state.view1
                };
                let target = if target_index == 0 {
                    dataset::pose(0)
                } else {
                    state.view1
                };
                let mut block_residual = Matrix::<6, 1, f64>::zeros();
                let mut full_jacobian = Matrix::<6, 12, f64>::zeros();
                between_factor_pose3_factor(
                    &source,
                    &target,
                    &dataset::prior_pose(source_index, target_index),
                    &dataset::prior_info(source_index, target_index),
                    dataset::EPSILON,
                    Some(&mut block_residual),
                    Some(&mut full_jacobian),
                    None,
                    None,
                );

                let local_offset = if source_index == 1 { 0 } else { POSE_DIM };
                let mut block_jacobian = Matrix::<6, 6, f64>::zeros();
                for block_row in 0..6 {
                    for column in 0..6 {
                        block_jacobian[(block_row, column)] =
                            full_jacobian[(block_row, local_offset + column)];
                    }
                }
                linearization
                    .add_block(&block_residual, &block_jacobian, &[0, 1, 2, 3, 4, 5])
                    .expect("pose prior fits generated residual layout");
            }
        }

        for index in 0..dataset::NUM_LANDMARKS {
            let mut block_residual = Matrix::<2, 1, f64>::zeros();
            let mut block_jacobian = Matrix::<2, 7, f64>::zeros();
            inverse_range_landmark_linear_gnc_factor(
                &dataset::pose(0),
                &dataset::calibration(0),
                &state.view1,
                &dataset::calibration(1),
                state.landmarks[index],
                &dataset::source_pixel(index),
                &dataset::target_pixel(index),
                dataset::match_weight(index),
                dataset::GNC_MU,
                dataset::GNC_SCALE,
                dataset::EPSILON,
                Some(&mut block_residual),
                Some(&mut block_jacobian),
                None,
                None,
            );
            linearization
                .add_block(
                    &block_residual,
                    &block_jacobian,
                    &[0, 1, 2, 3, 4, 5, POSE_DIM + index],
                )
                .expect("reprojection factor fits generated residual layout");
        }

        for index in 0..dataset::NUM_LANDMARKS {
            let mut block_residual = Matrix::<1, 1, f64>::zeros();
            let mut block_jacobian = Matrix::<1, 1, f64>::zeros();
            inverse_range_landmark_prior_factor(
                state.landmarks[index],
                dataset::landmark_prior(index),
                dataset::match_weight(index),
                100.0,
                dataset::EPSILON,
                Some(&mut block_residual),
                Some(&mut block_jacobian),
                None,
                None,
            );
            linearization
                .add_block(&block_residual, &block_jacobian, &[POSE_DIM + index])
                .expect("inverse-range prior fits generated residual layout");
        }
    }
}
